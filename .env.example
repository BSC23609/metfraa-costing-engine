# METFRAA Costing Engine — environment variables
# Copy this file to .env for local dev. On Render, set these in the dashboard.

# Microsoft Azure App Registration (Files.ReadWrite.All + admin consent required)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Email of the OneDrive owner that holds Master_Cost_DB.xlsx
TARGET_USER_EMAIL=

# Optional: password to gate the Settings rate editor.
# If blank, anyone using the app can edit master rates.
ADMIN_PASSWORD=

# Render injects PORT automatically. Override only for local dev if needed.
# PORT=3000
