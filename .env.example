# ========================================
# METFRAA Costing Engine — Environment Vars
# ========================================
# Copy this file to .env and fill in real values for local dev.
# On Render, set these in the dashboard under "Environment".

# --- Microsoft Azure App Registration ---
# These come from your Azure App Registration that has Files.ReadWrite.All
# (application permission) granted with admin consent.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- OneDrive owner ---
# The email address of the user whose OneDrive holds Master_Cost_DB.xlsx
TARGET_USER_EMAIL=

# --- Optional: Rate-editor password ---
# If set, the Settings page will require this password before unlocking.
# If left blank, the rate editor is open to anyone using the app.
ADMIN_PASSWORD=

# --- Server ---
# Render injects PORT automatically. Override only for local dev if needed.
# PORT=3000
